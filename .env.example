# Ollama connection
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# Optional one-time owner bootstrap for a fresh deployment (minimum 12 characters).
# Keep this secret; after first initialization, changing it will not reset the password.
TRAVEL_PLANNER_INITIAL_PASSWORD=
COOKIE_SECURE=false

# Backend
BACKEND_PORT=8000

# Agent safety cap (defensive only — not the stopping mechanism)
MAX_ITERATIONS=6

# Exchange rates (Frankfurter / ECB reference rates, no API key required)
# FX_ENABLED=false pins the bundled demonstration table.
FX_ENABLED=true
FX_REFRESH_HOURS=6
FX_TIMEOUT_SECONDS=4
