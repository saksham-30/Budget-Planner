# Ollama connection
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# Backend
BACKEND_PORT=8000

# Agent safety cap (defensive only — not the stopping mechanism)
MAX_ITERATIONS=6

# Exchange rates (Frankfurter / ECB reference rates, no API key required)
# FX_ENABLED=false pins the bundled demonstration table.
FX_ENABLED=true
FX_REFRESH_HOURS=6
FX_TIMEOUT_SECONDS=4
